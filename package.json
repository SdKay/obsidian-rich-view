{
    "name": "rich-view",
    "version": "1.0.0",
    "description": "Render draw.io, Visio (and, in future, other rich file formats — ppt, Word, CAD, ...) inline in Obsidian notes.",
    "main": "main.js",
    "type": "module",
    "scripts": {
        "dev": "node esbuild.config.mjs",
        "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
        "lint": "eslint .",
        "test": "vitest run"
    },
    "keywords": [
        "obsidian",
        "drawio",
        "visio",
        "diagram"
    ],
    "license": "MIT",
    "author": "sdking.xing",
    "repository": {
        "type": "git",
        "url": "https://github.com/SdKay/obsidian-rich-view.git"
    },
    "homepage": "https://github.com/SdKay/obsidian-rich-view",
    "dependencies": {
        "@aiden0z/pptx-renderer": "^1.3.0",
        "@maxgraph/core": "^0.23.0",
        "fflate": "^0.8.3",
        "pako": "^2.1.0"
    },
    "devDependencies": {
        "@eslint/js": "^9.39.4",
        "@types/node": "^22.15.17",
        "@types/pako": "^2.0.3",
        "esbuild": "0.25.5",
        "eslint": "^9.39.4",
        "eslint-plugin-obsidianmd": "^0.4.2",
        "globals": "^17.6.0",
        "jiti": "^2.6.1",
        "jsdom": "^30.0.1",
        "obsidian": "latest",
        "typescript": "^5.8.3",
        "typescript-eslint": "^8.59.1",
        "vitest": "^4.1.11"
    }
}
